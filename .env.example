# --- LLM ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Market Data ---
ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Vector DB ---
# "chroma" for local dev, "pinecone" for production
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_db
PINECONE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=finance-kb

# --- News (optional, for News Synthesizer Agent) ---
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- App ---
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300

# --- Conversation memory / session persistence ---
# "memory" (default): in-process only, wiped on restart — fine for
#   ephemeral hosts like Streamlit Community Cloud.
# "sqlite": persists to a local file, durable across restarts on a
#   machine/server you control (e.g. running locally or on your own VM).
CHECKPOINTER_BACKEND=memory
SQLITE_CHECKPOINT_PATH=./checkpoints.sqlite

# --- Multi-user accounts (opt-in) ---
# false (default): single shared APP_PASSWORD gate above, no individual
#   accounts.
# true: real per-person signup + login (src/auth/), each user gets their
#   own persisted portfolio and their own conversation memory.
ENABLE_MULTI_USER_AUTH=false
USERS_YAML_PATH=./users.yaml
# Signs/encrypts the browser auth cookie. Generate a real random value for
# any real deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=dev-only-insecure-default-change-me
USER_DATA_DIR=./user_data
