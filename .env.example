# --- LLM ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Market Data ---
ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Vector DB ---
# "chroma" for local dev, "pinecone" for production
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_db
PINECONE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=finance-kb

# --- News (optional, for News Synthesizer Agent) ---
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- App ---
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
